# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Secret for user session signing and license tokens
JWT_SECRET="replace_with_super_secure_random_jwt_secret_key"

# Payment Provider Selection ('razorpay' | 'cashfree')
PAYMENT_PROVIDER="razorpay"

# Razorpay Subscriptions Configuration (Server-Only)
RAZORPAY_KEY_ID="rzp_test_YourRazorpayKeyIdHere"
RAZORPAY_KEY_SECRET="replace_with_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_razorpay_webhook_secret"
RAZORPAY_MONTHLY_PLAN_ID="plan_QBot2Monthly49"
RAZORPAY_YEARLY_PLAN_ID="plan_QBot2Yearly470"

# Optional: Cashfree Billing Configuration (for seamless future swap)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# Product Downloads Configuration
APP_DOWNLOAD_URL="https://releases.algotrders.site/qbot2-windows-latest.zip"
APK_DOWNLOAD_URL="https://releases.algotrders.site/qbot2-android-v2.1.0.apk"

# Admin Access Credential (optional override)
ADMIN_SECRET_KEY="admin_master_access_key"

