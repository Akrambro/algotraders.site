# Server-only settings. Never prefix signing secrets or Supabase credentials with VITE_.
NODE_ENV=development
APP_URL=http://localhost:3000
SUPABASE_URL=https://myrqldmzekujotuvxfnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Run npm run license:keys. Keep .secrets/render-licensing.env private.
# JWT_SECRET signs website login sessions; LICENSE_PRIVATE_KEY_B64 signs bot leases.
JWT_SECRET=
LICENSE_PRIVATE_KEY_B64=

# License hashes are stored in Supabase qbot_licenses, linked to the customer's
# qbot_users record (name and email) by user_id. Full keys are never stored.

# Set these only after uploading the NEW licensed release files.
# Old unlicensed binaries do not gain protection when the website is updated.
# Each HTTPS URL requires the SHA-256 of the tested, licensed artifact.
# Legacy APP_DOWNLOAD_* and APK_DOWNLOAD_* variables are ignored.
LICENSED_WINDOWS_DOWNLOAD_URL=
LICENSED_ANDROID_DOWNLOAD_URL=
LICENSED_WINDOWS_DOWNLOAD_SHA256=
LICENSED_ANDROID_DOWNLOAD_SHA256=
LICENSED_WINDOWS_DOWNLOAD_SIZE=
LICENSED_ANDROID_DOWNLOAD_SIZE=

# No payment gateway, demo accounts, anonymous Supabase key, or MySQL is needed.
